nn.Module):\n","    def __init__(self, embed_dim, head_dim, block_size):\n","        super().__init__()\n","        self.key = nn.Linear(embed_dim, head_dim, bias=False)\n","        self.query = nn.Linear(embed_dim, head_dim, bias=False)\n","        self.value = nn.Linear(embed_dim, head_dim, bias=False)\n","        # causal mask: lower-triangular matrix so position i can only see positions <= i\n","        self.register_buffer('tril', torch.tril(torch.ones(block_size, block_size)))\n","\n","    def forward(self, x):\n","        B, T, C = x.shape  # batch, sequence length, embedding dim\n","\n","        k = self.key(x)    # (B, T, head_dim)\n","        q = self.query(x)  # (B, T, head_dim)\n","        v = self.value(x)  # (B, T, head_dim)\n","\n","        # attention scores: how much each token attends to every other token\n","        wei = q @ k.transpose(-2, -1) * (k.shape[-1] ** -0.5)  # (B, T, T)\n","\n","        # apply causal mask: block attention to future tokens\n","        wei = wei.masked_fill(self.tril[:T, :T] == 0, float('-inf'))\n","        wei = F.softmax(wei, dim=-1)  # normalize into probabilities\n","\n","        out = wei @ v  # (B, T, head_dim) — weighted sum of values\n","        return out"]},{"cell_type":"code","execution_count":4,"id":"69ed483e","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:44:28.370352Z","iopub.status.busy":"2026-09-24T17:44:28.37014Z","iopub.status.idle":"2026-09-24T17:44:28.542017Z","shell.execute_reply":"2026-09-24T17:44:28.540771Z"},"papermill":{"duration":0.176613,"end_time":"2026-09-24T17:44:28.543871+00:00","exception":false,"start_time":"2026-09-24T17:44:28.367258+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Input shape:  torch.Size([4, 8, 32])\n","Output shape: torch.Size([4, 8, 16])\n"]}],"source":["torch.manual_seed(42)\n","\n","B, T, C = 4, 8, 32   # batch=4, seq_len=8, embed_dim=32\n","head_dim = 16\n","\n","x = torch.randn(B, T, C)  # fake input embeddings\n","\n","attn = SingleHeadAttention(embed_dim=C, head_dim=head_dim, block_size=T)\n","out = attn(x)\n","\n","print(\"Input shape: \", x.shape)\n","print(\"Output shape:\", out.shape)  # should be (4, 8, 16)"]},{"cell_type":"code","execution_count":5,"id":"22512dda","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:44:28.549728Z","iopub.status.busy":"2026-09-24T17:44:28.54944Z","iopub.status.idle":"2026-09-24T17:44:28.555554Z","shell.execute_reply":"2026-09-24T17:44:28.554837Z"},"papermill":{"duration":0.010877,"end_time":"2026-09-24T17:44:28.557224+00:00","exception":false,"start_time":"2026-09-24T17:44:28.546347+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class MultiHeadAttention(nn.Module):\n","    def __init__(self, embed_dim, num_heads, block_size):\n","        super().__init__()\n","        head_dim = embed_dim // num_heads\n","        self.heads = nn.ModuleList([\n","            SingleHeadAttention(embed_dim, head_dim, block_size) for _ in range(num_heads)\n","        ])\n","        self.proj = nn.Linear(embed_dim, embed_dim)  # combine heads back to embed_dim\n","\n","    def forward(self, x):\n","        out = torch.cat([h(x) for h in self.heads], dim=-1)  # concat along head_dim -> back to embed_dim\n","        out = self.proj(out)\n","        return out"]},{"cell_type":"code","execution_count":6,"id":"10acd99e","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:44:28.562099Z","iopub.status.busy":"2026-09-24T17:44:28.561885Z","iopub.status.idle":"2026-09-24T17:44:28.58945Z","shell.execute_reply":"2026-09-24T17:44:28.588423Z"},"papermill":{"duration":0.032005,"end_time":"2026-09-24T17:44:28.591087+00:00","exception":false,"start_time":"2026-09-24T17:44:28.559082+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Input shape:  torch.Size([4, 8, 32])\n","Output shape: torch.Size([4, 8, 32])\n"]}],"source":["torch.manual_seed(42)\n","\n","B, T, C = 4, 8, 3