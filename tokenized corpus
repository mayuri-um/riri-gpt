                      # (B, T, embed_dim)\n","        pos_emb = self.position_embedding(torch.arange(T, device=idx.device))  # (T, embed_dim)\n","        x = tok_emb + pos_emb                                             # (B, T, embed_dim)\n","\n","        x = self.blocks(x)     # pass through all transformer blocks\n","        x = self.ln_f(x)       # final layer norm\n","        logits = self.lm_head(x)  # (B, T, vocab_size)\n","\n","        if targets is None:\n","            loss = None\n","        else:\n","            B, T, V = logits.shape\n","            logits = logits.view(B * T, V)\n","            targets = targets.view(B * T)\n","            loss = F.cross_entropy(logits, targets)\n","\n","        return logits, loss"]},{"cell_type":"code","execution_count":10,"id":"074a4d38","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:14.109282Z","iopub.status.busy":"2026-09-24T17:53:14.109085Z","iopub.status.idle":"2026-09-24T17:53:14.212493Z","shell.execute_reply":"2026-09-24T17:53:14.211577Z"},"papermill":{"duration":0.108207,"end_time":"2026-09-24T17:53:14.214138+00:00","exception":false,"start_time":"2026-09-24T17:53:14.105931+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Logits shape: torch.Size([512, 8000])\n","Loss: 9.136002540588379\n"]}],"source":["torch.manual_seed(42)\n","\n","vocab_size = 8000   # matches your BPE tokenizer's vocab_size\n","embed_dim = 128\n","num_heads = 4\n","num_layers = 4\n","block_size = 128\n","\n","model = MiniGPT(vocab_size, embed_dim, num_heads, num_layers, block_size)\n","\n","# fake batch of token IDs\n","B, T = 4, block_size\n","idx = torch.randint(0, vocab_size, (B, T))\n","targets = torch.randint(0, vocab_size, (B, T))\n","\n","logits, loss = model(idx, targets)\n","print(\"Logits shape:\", logits.shape)   # (B*T, vocab_size)\n","print(\"Loss:\", loss.item())            # should be roughly ln(vocab_size) ≈ 8.99 for random init"]},{"cell_type":"code","ex