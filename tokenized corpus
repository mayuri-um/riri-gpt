n.Module):\n","    def __init__(self, embed_dim, head_dim, block_size):\n","        super().__init__()\n","        self.key = nn.Linear(embed_dim, head_dim, bias=False)\n","        self.query = nn.Linear(embed_dim, head_dim, bias=False)\n","        self.value = nn.Linear(embed_dim, head_dim, bias=False)\n","        # causal mask: lower-triangular matrix so position i can only see positions <= i\n","        self.register_buffer('tril', torch.tril(torch.ones(block_size, block_size)))\n","\n","    def forward(self, x):\n","        B, T, C = x.shape  # batch, sequence length, embedding dim\n","\n","        k = self.key(x)    # (B, T, head_dim)\n","        q = self.query(x)  # (B, T, head_dim)\n","        v = self.value(x)  # (B, T, head_dim)\n","\n","        # attention scores: how much each token attends to every other token\n","        wei = q @ k.transpose(-2, -1) * (k.shape[-1] ** -0.5)  # (B, T, T)\n","\n","        # apply causal mask: block attention to future tokens\n","        wei = wei.masked_fill(self.tril[:T, :T] == 0, float('-inf'))\n","        wei = F.softmax(wei, dim=-1)  # normalize into probabilities\n","\n","        out = wei @ v  # (B, T, head_dim) — weighted sum of values\n","        return out"]},{"cell_type":"code","execution_count":4,"id":"633e0eba","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:13.884667Z","iopub.status.busy":"2026-09-24T17:53:13.884158Z","iopub.status.idle":"2026-09-24T17:53:13.975099Z","shell.execute_reply":"2026-09-24T17:53:13.974329Z"},"papermill":{"duration":0.095416,"end_time":"2026-09-24T17:53:13.976559+00:00","exception":false,"start_time":"2026-09-24T17:53:13.881143+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Input shape:  torch.Size([4, 8, 32])\n","Output shape: torch.Size([4, 8, 16])\n"]}],"source":["torch.manual_seed(42)\n","\n","B, T, C = 4, 8, 32   # batch=4, seq_len=8, embed_dim=32\n","head_dim = 16\n","\n","x = torch.randn(B, T, C)  # fake input embeddings\n","\n","attn = SingleHeadAttention(embed_dim=C, head_dim=head_dim, block_size=T)\n","out = attn(x)\n","\n","print(\"Input shape: \", x.shape)\n","print(\"Output shape:\", out.shape)  # should be (4, 8, 16)"]},{"cell_type":"code","execution_count":5,"id":"63ec194c","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:13.982864Z","iopub.status.busy":"2026-09-24T17:53:13.982312Z","iopub.status.idle":"2026-09-24T17:53:13.987257Z","shell.execute_reply":"2026-09-24T17:53:13.986605Z"},"papermill":{"duration":0.009706,"end_time":"2026-09-24T17:53:13.9887+00:00","exception":false,"start_time":"2026-09-24T17:53:13.978994+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class MultiHeadAttention(nn.Module):\n","    def __init__(self, embed_dim, num_heads, block_size):\n","        super().__init__()\n","        head_dim = embed_dim // num_heads\n","        self.heads = nn.ModuleList([\n","            SingleHeadAttention(embed_dim, head_dim, block_size) for _ in range(num_heads)\n","        ])\n","        self.proj = nn.Linear(embed_dim, embed_dim)  # combine heads back to embed_dim\n","\n","    def forward(self, x):\n","        out = torch.cat([h(x) for h in self.heads], dim=-1)  # concat along head_dim -> back to embed_dim\n","        out = self.proj(out)\n","        return out"]},{"cell_type":"code","execution_count":6,"id":"a915352c","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:13.994581Z","iopub.status.busy":"2026-09-24T17:53:13.99406Z","iopub.status.idle":"2026-09-24T17:53:14.011391Z","shell.execute_reply":"2026-09-24T17:53:14.010642Z"},"papermill":{"duration":0.021812,"end_time":"2026-09-24T17:53:14.012827+00:00","exception":false,"start_time":"2026-09-24T17:53:13.991015+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Input shape:  torch.Size([4, 8, 32])\n","Output shape: torch.Size([4, 8, 32])\n"]}],"source":["torch.manual_seed(42)\n","\n","B, T, C = 4, 8, 32   # same as before\n","num_heads = 4         # 32 / 4 = 8-dim per head\n","\n","x = torch.randn(B, T, C)\n","\n","mha = MultiHeadAttention(embed_dim=C, num_heads=num_heads, block_size=T)\n","out = mha(x)\n","\n","print(\"Input shape: \", x.shape)\n","print(\"Output shape:\", out.shape)  # should be (4, 8, 32) — back to original embed_dim"]},{"cell_type":"code","execution_count":7,"id":"97ec9e01","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:14.018747Z","iopub.status.busy":"2026-09-24T17:53:14.018056Z","iopub.status.idle":"2026-09-24T17:53:14.025612Z","shell.execute_reply":"2026-09-24T17:53:14.024839Z"},"papermill":{"duration":0.012239,"end_time":"2026-09-24T17:53:14.027354+00:00","exception":false,"start_time":"2026-09-24T17:53:14.015115+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class FeedForward(nn.Module):\n","    \"\"\"Simple MLP: expand, non-linearity, project back down\"\"\"\n","    def __init__(self, embed_dim):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(embed_dim, 4 * embed_dim),\n","            nn.GELU(),\n","            nn.Linear(4 * embed_dim, embed_dim),\n","        )\n","\n","    def forward(self, x):\n","        return self.net(x)\n","\n","\n","class TransformerBlock(nn.Module):\n","    def __init__(self, embed_dim, num_heads, block_size):\n","        super().__init__()\n","        self.ln1 = nn.LayerNorm(embed_dim)\n","        self.attn = MultiHeadAttention(embed_dim, num_heads, block_size)\n","        self.ln2 = nn.LayerNorm(embed_dim)\n","        self.ffwd = FeedForward(embed_dim)\n","\n","    def forward(self, x):\n","        x = x + self.attn(self.ln1(x))   # residual connection around attention\n","        x = x + self.ffwd(self.ln2(x))   # residual connection around feedforward\n","        return x"]},{"cell_type":"code","execution_count":8,"id":"b24ff201","metadata":{"execution":{"iopub.execute_input":"2026-09-24T17:53:14.033743Z","iopub.status.busy":"2